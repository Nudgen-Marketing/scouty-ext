{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://scouty.to/scouty-b2b",
  "permissions": ["scripting", "storage", "identity"],
  "host_permissions": ["<LINKEDIN_PATTERN>", "<API_PATTERN>"],
  "action": { "default_title": "__MSG_extTitle__", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src <API_ORIGIN>; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
